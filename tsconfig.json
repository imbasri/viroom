{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "server/**/*.ts", "tests/**/*.ts", "web/**/*.ts"]
}
