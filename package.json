{
  "name": "viroom",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch src/index.ts",
    "dev:web": "cd frontend && bun run dev",
    "start": "bun run src/index.ts",
    "build": "cd frontend && bun run build",
    "vendor": "mkdir -p web/vendor && cp node_modules/three/build/three.module.js web/vendor/three.module.js",
    "typecheck": "bun run typecheck:server && bun run typecheck:web",
    "typecheck:server": "bunx tsc --noEmit",
    "typecheck:web": "cd frontend && bun run typecheck",
    "build:web": "tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:node": "node --experimental-strip-types --test tests/office3d-layout.test.ts",
    "lint:secrets": "gitleaks protect --verbose --config .gitleaks.toml 2>/dev/null || echo 'gitleaks not installed locally; CI enforces it'"
  },
  "dependencies": {
    "elysia": "^1.4.30",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.2.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
